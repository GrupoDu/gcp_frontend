{
  "name": "gcp_front",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:start": "npm run build && npm run start",
    "start": "npx next start . -p 3001 -H 0.0.0.0",
    "lint": "eslint",
    "docker:compose": "docker compose -f docker-compose.dev.yaml watch",
    "docker:build-prod": "docker compose -f docker-compose.prod.yaml build",
    "docker:up-prod": "docker compose -f docker-compose.prod.yaml up -d",
    "docker:down-prod": "docker compose -f docker-compose.prod.yaml down",
    "docker:down-dev": "docker compose -f docker-compose.dev.yaml down",
    "docker:build-dev": "docker compose -f docker-compose.dev.yaml build",
    "docker:up-dev": "docker compose -f docker-compose.dev.yaml up -d",
    "docker:build-up-dev": "pnpm docker:build-dev && pnpm docker:up-dev",
    "docker:build-up-prod": "$npm_execpath docker:build-prod && $npm_execpath docker:up-prod"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource/roboto": "^5.2.9",
    "@mui/material": "^7.3.7",
    "@mui/x-charts": "^8.27.0",
    "axios": "^1.13.5",
    "generate-password-ts": "^1.6.5",
    "next": "16.1.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-icons": "^5.5.0",
    "react-spinners": "^0.17.0",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/socket.io": "^3.0.2",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "prettier": "^3.8.1",
    "react-toastify": "^11.0.5",
    "sass": "^1.97.3",
    "typescript": "^5"
  }
}
